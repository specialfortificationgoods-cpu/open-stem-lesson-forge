{
  "title": "Request Moderation Report",
  "description": "Closed MVP fixture schema for the deterministic dummy moderation report; intentionally narrower than the future production moderation-report envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_moderation_report_id",
    "request_moderation_task_id",
    "request_id",
    "lease_id",
    "moderation_kind",
    "decision",
    "category_flags",
    "safe_reason_codes"
  ],
  "properties": {
    "request_moderation_report_id": { "type": "string" },
    "request_moderation_task_id": { "type": "string" },
    "request_id": { "type": "string" },
    "lease_id": { "type": "string" },
    "moderation_kind": { "const": "dummy_fixture" },
    "decision": { "const": "allow_mvp_planning" },
    "category_flags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "none" }
    },
    "safe_reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "moderation_allowed" }
    }
  }
}
