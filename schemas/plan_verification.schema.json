{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "proposal_id",
    "verification_task_id",
    "verifier_runner_id",
    "verification_type",
    "status",
    "outcome",
    "findings",
    "checked_items",
    "authority"
  ],
  "$defs": {
    "checked_items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "required_artifacts_present",
          "human_review_gate_present",
          "no_student_grading",
          "no_credential_handling",
          "no_arbitrary_prompt",
          "validation_plan_present"
        ]
      }
    },
    "safe_finding_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!.*(?:://|@|[Ss][Ee][Cc][Rr][Ee][Tt]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Tt][Uu][Dd][Ee][Nn][Tt] [Rr][Ee][Cc][Oo][Rr][Dd]|[Ss][Tt][Uu][Dd][Ee][Nn][Tt] [Gg][Rr][Aa][Dd][Ee]|[Ss][Tt][Uu][Dd][Ee][Nn][Tt] [Pp][Ll][Aa][Cc][Ee][Mm][Ee][Nn][Tt]|[Ss][Tt][Uu][Dd][Ee][Nn][Tt] [Pp][Rr][Oo][Ff][Ii][Ll][Ee]|[Pp][Ll][Aa][Cc][Ee][Mm][Ee][Nn][Tt] [Dd][Ee][Cc][Ii][Ss][Ii][Oo][Nn]|[Dd][Ii][Ss][Cc][Ii][Pp][Ll][Ii][Nn][Aa][Rr][Yy] [Rr][Ee][Cc][Oo][Rr][Dd]|[Dd][Ii][Ss][Cc][Ii][Pp][Ll][Ii][Nn][Aa][Rr][Yy] [Aa][Cc][Tt][Ii][Oo][Nn]|/Users/|/home/|/etc/|/private/|/var/|/tmp/|C:\\\\|\\.\\./|~/|[Ss][Ss][Hh]/|[Hh][Uu][Mm][Aa][Nn] [Aa][Pp][Pp][Rr][Oo][Vv][Aa][Ll]|[Hh][Uu][Mm][Aa][Nn] [Aa][Pp][Pp][Rr][Oo][Vv][Ee][Dd]|[Pp][Ee][Ee][Rr] [Rr][Ee][Vv][Ii][Ee][Ww][Ee][Dd]|[Pp][Ee][Ee][Rr]_[Rr][Ee][Vv][Ii][Ee][Ww][Ee][Dd]|[Pp][Rr][Oo][Mm][Oo][Tt][Ee]|[Pp][Rr][Oo][Mm][Oo][Tt][Ii][Oo][Nn]|[Pp][Uu][Bb][Ll][Ii][Ss][Hh]|[Pp][Uu][Bb][Ll][Ii][Cc][Aa][Tt][Ii][Oo][Nn]|[Ss][Tt][Aa][Tt][Ee] [Oo][Vv][Ee][Rr][Rr][Ii][Dd][Ee]|[Oo][Vv][Ee][Rr][Rr][Ii][Dd][Ee] [Ss][Tt][Aa][Tt][Ee]|[Aa][Cc][Cc][Ee][Pp][Tt][Ee][Dd] [Vv][Ee][Rr][Ii][Ff][Ii][Cc][Aa][Tt][Ii][Oo][Nn])).{1,500}$"
    },
    "finding_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_name", "severity", "message"],
      "properties": {
        "check_name": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "severity": { "enum": ["warning", "blocking"] },
        "message": { "$ref": "#/$defs/safe_finding_message" }
      }
    }
  },
  "properties": {
    "verification_id": { "type": "string", "pattern": "^pverify_[a-z0-9_-]+$" },
    "proposal_id": { "const": "plan_energy_001_a" },
    "verification_task_id": { "const": "pvtask_energy_001_a" },
    "verifier_runner_id": { "const": "actor_verifier_001" },
    "verification_type": { "const": "plan_schema_policy_cross_check" },
    "status": { "const": "submitted" },
    "outcome": { "enum": ["no_blocking_findings", "blocking_findings", "warnings_only"] },
    "findings": { "type": "array", "maxItems": 20 },
    "checked_items": { "$ref": "#/$defs/checked_items" },
    "authority": { "const": "advisory_only" }
  },
  "anyOf": [
    {
      "properties": {
        "outcome": { "const": "no_blocking_findings" },
        "findings": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "outcome": { "const": "warnings_only" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/finding_item" },
              { "properties": { "severity": { "const": "warning" } } }
            ]
          }
        }
      }
    },
    {
      "properties": {
        "outcome": { "const": "blocking_findings" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/finding_item" },
              { "properties": { "severity": { "const": "blocking" } } }
            ]
          }
        }
      }
    }
  ]
}
