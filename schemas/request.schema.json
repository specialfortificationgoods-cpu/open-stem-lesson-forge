{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVP Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subject",
    "topic",
    "age_range",
    "language",
    "lesson_duration_minutes",
    "desired_artifacts",
    "constraints",
    "license_preference",
    "visibility",
    "forbidden_content_acknowledged"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subject": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "topic": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "age_range": {
      "type": "string",
      "pattern": "^[0-9]{1,2}-[0-9]{1,2}$",
      "description": "Inclusive lower-exclusive upper age band. The deterministic request validator additionally enforces positive bounds, low < high, and MVP-supported bounds."
    },
    "language": { "const": "en" },
    "lesson_duration_minutes": { "type": "integer", "minimum": 15, "maximum": 180 },
    "desired_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["worksheet", "answer_key", "python_checker", "teacher_notes"] }
    },
    "constraints": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 240 }
    },
    "license_preference": { "const": "CC-BY-4.0" },
    "visibility": { "enum": ["public", "private"] },
    "forbidden_content_acknowledged": { "const": true },
    "auto_repair_preference": {
      "enum": ["no_automated_repair", "request_bounded_code_repair"]
    }
  }
}
