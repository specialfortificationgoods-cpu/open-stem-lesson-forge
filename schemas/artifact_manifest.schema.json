{
  "title": "Artifact Manifest",
  "description": "Closed MVP artifact fixture schema for the conservation-of-energy vertical slice; intentionally narrower than the future production artifact-manifest envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "request_id",
    "work_packet_ids",
    "title",
    "subject",
    "topic",
    "age_range",
    "language",
    "license",
    "status_claim",
    "ai_assisted",
    "contents",
    "known_limitations"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "request_id": { "const": "req_energy_001" },
    "work_packet_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "const": "wp_generate" }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subject": { "const": "physics" },
    "topic": { "const": "conservation_of_energy" },
    "age_range": { "const": "14-16" },
    "language": { "const": "en" },
    "license": { "const": "CC-BY-4.0" },
    "status_claim": { "const": "draft_generated" },
    "ai_assisted": { "const": true },
    "contents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 120 }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 240 }
    }
  }
}
